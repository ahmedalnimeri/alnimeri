# Cloudflare Pages header rules.
#
# HTML must always be revalidated. Without this, a browser can pair freshly
# deployed markup with a cached stylesheet — which is how the brand mark once
# rendered at its full 900px, and how an old figure kept showing after it had
# been corrected. must-revalidate costs one conditional request and removes a
# whole class of "it still shows the old version" confusion.
#
# And on everything: HTTPS only, for a year, on every subdomain too (no
# preload: that list is hard to leave); nobody may frame the site; no page
# asks for the camera, the microphone or the location, so none can.
# functions/_middleware.js adds the same three to what a Function renders,
# which this file never reaches.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fingerprinted and content-stable assets can be cached hard. Stylesheet and
# script carry a ?v= query that changes on every edit, so a stale copy can
# never be paired with new HTML.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=604800, must-revalidate

/main.js
  Cache-Control: public, max-age=604800, must-revalidate

# The home page's refinement sheet and motion script carry md5[:8] of their own
# bytes as ?v= (rewritten by bin-stamp-assets.py on every run), so a new edit
# is always a new URL and the old one never needs revalidating.
/refinement.css
  Cache-Control: public, max-age=31536000, immutable

/motion.js
  Cache-Control: public, max-age=31536000, immutable

# The film hover layer (home + pulled reels), stamped the same way (and by bin-build-reel.py).
/design-hover.css
  Cache-Control: public, max-age=31536000, immutable

/design-hover.js
  Cache-Control: public, max-age=31536000, immutable

# The film pages' and /work/'s design layer, stamped with md5[:8] by
# bin-build-work-pages.py.
/design-filmpages.css
  Cache-Control: public, max-age=31536000, immutable

/design-filmpages.js
  Cache-Control: public, max-age=31536000, immutable

# /about's design layer, stamped by bin-stamp-assets.py.
/design-about.css
  Cache-Control: public, max-age=31536000, immutable

/design-about.js
  Cache-Control: public, max-age=31536000, immutable

# The home page's four compositions, stamped by bin-stamp-assets.py.
/design-compositions.css
  Cache-Control: public, max-age=31536000, immutable

/design-compositions.js
  Cache-Control: public, max-age=31536000, immutable

# The home page's ending (the end credits), stamped by bin-stamp-assets.py.
/design-ending.css
  Cache-Control: public, max-age=31536000, immutable

/design-ending.js
  Cache-Control: public, max-age=31536000, immutable

# The hero's moving films (the loops themselves are under /assets/), stamped
# by bin-stamp-assets.py.
/design-loops.css
  Cache-Control: public, max-age=31536000, immutable

/design-loops.js
  Cache-Control: public, max-age=31536000, immutable

# The visit log is private and must never be cached or indexed.
/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/llms.txt
  Content-Type: text/plain; charset=utf-8
