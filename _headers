# Cloudflare Pages header rules.
#
# HTML must always be revalidated. Without this, a browser can pair freshly
# deployed markup with a cached stylesheet — which is how the brand mark once
# rendered at its full 900px, and how an old figure kept showing after it had
# been corrected. must-revalidate costs one conditional request and removes a
# whole class of "it still shows the old version" confusion.
/*
  Cache-Control: public, max-age=0, must-revalidate

# Fingerprinted and content-stable assets can be cached hard. Stylesheet and
# script carry a ?v= query that changes on every edit, so a stale copy can
# never be paired with new HTML.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=604800, must-revalidate

/main.js
  Cache-Control: public, max-age=604800, must-revalidate

# The visit log is private and must never be cached or indexed.
/api/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# The sequence's own export. Plain text so it opens raw in the browser —
# a machine document as self-portrait, and curl-able on purpose.
/selects.edl
  Content-Type: text/plain; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8
