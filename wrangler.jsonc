{
  // Static-assets-only Worker: no server code, Cloudflare just serves these
  // files from its edge. There is no build step — the repo is the output.
  "name": "alnimeri",
  "compatibility_date": "2026-07-29",
  // Visit log. The database_id is filled in after creating the D1 database;
  // the binding name DB is what functions/_middleware.js expects.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "alnimeri_visits",
      "database_id": "dcee630a-90e2-47be-96a5-5d24e4035be1"
    }
  ],
  "assets": {
    "directory": "./",
    "not_found_handling": "404-page"
  }
}
